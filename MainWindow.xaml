<Window x:Class="SmartPaste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartPaste" Height="620" Width="640"
        Icon="assets/icon-192.png"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>

        <!-- ── Home card style ─────────────────────────────────── -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#1E40AF"/>
                    <Setter Property="Background" Value="#F0F5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Beta card style ─────────────────────────────────── -->
        <Style x:Key="BetaCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FCD34D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D97706"/>
                    <Setter Property="Background" Value="#FEF3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Help "?" icon style ─────────────────────────────── -->
        <Style x:Key="HelpTip" TargetType="Border">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
        </Style>

        <!-- ── Modifier toggle button style ────────────────────── -->
        <Style x:Key="ModToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1E40AF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Virtual keyboard key button style ───────────────── -->
        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ Header ═══════ -->
        <Border Grid.Row="0" Background="#1E40AF" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="assets/icon-192.png" Width="32" Height="32" Margin="0,0,12,0"/>
                <TextBlock Text="SmartPaste" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text=" v1.0" FontSize="14" Foreground="#93C5FD" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════ Tab Control ═══════ -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="1,1,1,0" BorderBrush="#9CA3AF" CornerRadius="4,4,0,0" Padding="14,7" Margin="0,0,2,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1E40AF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                                        <Setter Property="Foreground" Value="#1F2937"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TAB 0: HOME                                                     -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TabItem Header="Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,20">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Image Source="assets/icon-192.png" Width="52" Height="52" Margin="0,0,14,0"/>
                            <StackPanel>
                                <TextBlock Text="Welcome to SmartPaste" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Text="Your smart clipboard companion" FontSize="13" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Features" FontSize="15" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Rows="0" Margin="0,0,0,8">
                            <Border Style="{StaticResource HomeCard}" Margin="0,0,5,0" MouseLeftButtonDown="HomeCardFunctions_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Smart Paste" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock x:Name="TxtHomeSpStatus" Text="Active" FontSize="11" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Paste lists word-by-word with Enter or Space. Click to configure." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HomeCard}" Margin="5,0,0,0" MouseLeftButtonDown="HomeCardTelework_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌨️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Telework Mode" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock Text="Human-like typing" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Realistic typing simulation with variable rhythm and pauses. Click to configure." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="2" Rows="0" Margin="0,0,0,8">
                            <Border Style="{StaticResource HomeCard}" Margin="0,0,5,0" MouseLeftButtonDown="HomeCardFunctions_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔤" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Case Converter" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock x:Name="TxtHomeCcStatus" Text="Active" FontSize="11" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Cycle through lowercase, UPPERCASE, Title Case and more. Click to configure." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HomeCard}" Margin="5,0,0,0" MouseLeftButtonDown="HomeCardFunctions_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Always On Top" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock x:Name="TxtHomeAotStatus" Text="Active" FontSize="11" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Pin any window on top of all others. Click to configure." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Experimental" FontSize="15" FontWeight="SemiBold" Foreground="#374151" Margin="0,12,0,10"/>

                        <Border Style="{StaticResource BetaCard}" MouseLeftButtonDown="HomeCardBeta_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#D97706" CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Smart Copy — Image &amp; Web Capture" FontSize="14" FontWeight="SemiBold" Foreground="#92400E"/>
                                        <TextBlock x:Name="TxtHomeScStatus" Text="Disabled" FontSize="11" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Copies web content with images and converts them to a pasteable format. This feature is experimental and may not work reliably. Click to open Beta settings." FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <TextBlock FontSize="12" Foreground="#6B7280" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="tab:shortcuts" RequestNavigate="QuickLink_RequestNavigate" Foreground="#1E40AF" TextDecorations="Underline">Keyboard Shortcuts</Hyperlink>
                                <Run Text="  ·  "/>
                                <Hyperlink NavigateUri="tab:about" RequestNavigate="QuickLink_RequestNavigate" Foreground="#1E40AF" TextDecorations="Underline">About</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TAB 1: SHORTCUTS                                                -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TabItem Header="Shortcuts">
                <ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#111827">Keyboard Shortcuts</TextBlock>
                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,0,0,12" TextWrapping="Wrap">Click on any shortcut field to open the visual shortcut editor. You will pick modifier keys and a main key from a virtual keyboard.</TextBlock>

                        <Border BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="6" Background="#F3F4F6">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Smart Paste (Enter) -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Smart Paste (Enter)" Foreground="#111827"/>
                                    <Border Style="{StaticResource HelpTip}">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Pastes clipboard text word-by-word, pressing Enter after each word. Ideal for filling keyword fields, tag inputs, or any form requiring one entry per line. Automatically splits on commas, semicolons, periods, newlines, and other common delimiters."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="0" Grid.Column="1" x:Name="BorderSP1" BorderBrush="#9CA3AF" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,8" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtSP1" FontFamily="Consolas" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: Smart Paste (Space) -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Smart Paste (Space)" Foreground="#111827"/>
                                    <Border Style="{StaticResource HelpTip}">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Pastes clipboard text word-by-word, inserting a Space between each word. Useful for reformatting comma-separated lists into normal readable text with spaces."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="1" Grid.Column="1" x:Name="BorderSP2" BorderBrush="#9CA3AF" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,8" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtSP2" FontFamily="Consolas" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 2: Smart Paste (Normal) -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Smart Paste (Normal)" Foreground="#111827"/>
                                    <Border Style="{StaticResource HelpTip}">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Types the clipboard text character by character as if you were typing it manually. Works universally with any application including terminals and remote desktops. No splitting or special formatting."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="2" Grid.Column="1" x:Name="BorderSP3" BorderBrush="#9CA3AF" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,8" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtSP3" FontFamily="Consolas" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 3: Case Converter -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Case Converter" Foreground="#111827"/>
                                    <Border Style="{StaticResource HelpTip}">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Select text in any application, then press this shortcut to cycle through text cases: lowercase → UPPERCASE → Title Case → aLtErNaTiNg. Saves time when reformatting text without manual editing."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="3" Grid.Column="1" x:Name="BorderCC" BorderBrush="#9CA3AF" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,8" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtCC" FontFamily="Consolas" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 4: Always On Top -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Always On Top" Foreground="#111827"/>
                                    <Border Style="{StaticResource HelpTip}">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Pins the currently focused window so it stays above all other windows. Press the shortcut again to unpin. Useful for keeping reference material, notes, or documentation visible while working in another application."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="4" Grid.Column="1" x:Name="BorderAOT" BorderBrush="#9CA3AF" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,8" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtAOT" FontFamily="Consolas" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 5: Telework Mode -->
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Telework Mode" Foreground="#111827"/>
                                    <Border Style="{StaticResource HelpTip}">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Opens the Telework settings tab where you can configure realistic human typing simulation patterns including variable rhythm, micro-pauses, flow bursts, breathing pauses, and optional realistic typos."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="5" Grid.Column="1" x:Name="BorderTele" BorderBrush="#9CA3AF" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,8" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtTele" FontFamily="Consolas" Foreground="#1F2937" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 6: Smart Copy (Beta) -->
                                <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Smart Copy" Foreground="#92400E"/>
                                    <Border Background="#D97706" CornerRadius="3" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <Border Style="{StaticResource HelpTip}" Margin="6,0,0,0">
                                        <Border.ToolTip><TextBlock TextWrapping="Wrap" MaxWidth="280" Text="Copies web content including formatted text, math equations, and images. Attempts to download remote images and embed them. EXPERIMENTAL: image conversion may not work reliably across all target applications."/></Border.ToolTip>
                                        <TextBlock Text="?" Foreground="#1E40AF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="6" Grid.Column="1" x:Name="BorderSC" BorderBrush="#FCD34D" BorderThickness="1" Background="#FFFBEB" CornerRadius="4" Margin="0,0,0,0" Cursor="Hand" MouseDown="ShortcutBorder_MouseDown" Padding="4,2" MinHeight="28">
                                    <TextBlock x:Name="TxtSC" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#92400E"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TAB 2: TELEWORK                                                 -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TabItem Header="Telework">
                <ScrollViewer Padding="15" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#111827">Core Simulation</TextBlock>
                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,0,0,10" TextWrapping="Wrap">These options are mixed together to create a realistic human typing pattern.</TextBlock>

                        <CheckBox x:Name="ChkTeleVariable" Content="Variable Rhythm (random delay between keystrokes)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleMicroPauses" Content="Micro-Pauses (occasional &quot;thinking&quot; pauses)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleFlowBursts" Content="Flow Bursts (sudden rapid typing acceleration)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleBreathing" Content="Breathing Pauses (periodic longer rests)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleEndOfLine" Content="End-of-Line Pause (pause after Enter/newline)" Margin="0,0,0,15" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>

                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#111827">Realistic Errors</TextBlock>
                        <CheckBox x:Name="ChkTeleTypos" Content="Realistic Typos (wrong letter → Backspace → retype)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleCapsErrors" Content="Random Caps Errors (occasional wrong capitalization)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleDoubleKey" Content="Double Key Strokes (accidental double-tap)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleCursorNav" Content="Cursor Navigation (arrow key corrections)" Margin="0,0,0,4" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>
                        <CheckBox x:Name="ChkTeleAutoCorrect" Content="Auto-Correct Mistakes (fixes typos automatically)" Margin="0,0,0,15" Foreground="#111827" Checked="Tele_Changed" Unchecked="Tele_Changed"/>

                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#111827">Timing</TextBlock>
                        <TextBlock FontSize="12" Foreground="#374151" Margin="0,0,0,3">Base delay: <Run x:Name="TxtTeleDelay">100</Run> ms</TextBlock>
                        <Slider x:Name="SldTeleDelay" Minimum="20" Maximum="300" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldTeleDelay_ValueChanged"/>

                        <TextBlock FontSize="12" Foreground="#374151" Margin="0,0,0,3">Word chunk size: <Run x:Name="TxtTeleChunk">5</Run> characters</TextBlock>
                        <Slider x:Name="SldTeleChunk" Minimum="2" Maximum="20" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldTeleChunk_ValueChanged"/>

                        <TextBlock FontSize="12" Foreground="#374151" Margin="0,0,0,3">Breathing interval: every <Run x:Name="TxtTeleBreath">15</Run> characters</TextBlock>
                        <Slider x:Name="SldTeleBreath" Minimum="5" Maximum="50" Value="15" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,5" ValueChanged="SldTeleBreath_ValueChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TAB 3: FUNCTIONS                                                -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TabItem Header="Functions">
                <ScrollViewer Padding="15" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#111827">Enable / Disable Features</TextBlock>
                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,0,0,15" TextWrapping="Wrap">Toggle individual features on or off. Disabled features will not respond to their shortcuts.</TextBlock>

                        <CheckBox x:Name="ChkEnableSP" Content="Smart Paste (list pasting modes)" Margin="0,0,0,2" FontWeight="SemiBold" Foreground="#111827" Checked="Func_Changed" Unchecked="Func_Changed"/>
                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="20,0,0,8" TextWrapping="Wrap">Pastes clipboard content word-by-word into any application. Three modes: word-by-word with Enter, word-by-word with Space, and normal letter-by-letter typing.</TextBlock>

                        <CheckBox x:Name="ChkEnableCC" Content="Case Converter (text case cycling)" Margin="0,0,0,2" FontWeight="SemiBold" Foreground="#111827" Checked="Func_Changed" Unchecked="Func_Changed"/>
                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="20,0,0,8" TextWrapping="Wrap">Selects text and cycles through different text cases: lowercase, UPPERCASE, Title Case, and aLtErNaTiNg CaSe.</TextBlock>

                        <CheckBox x:Name="ChkEnableAOT" Content="Always On Top (window pinning)" Margin="0,0,0,2" FontWeight="SemiBold" Foreground="#111827" Checked="Func_Changed" Unchecked="Func_Changed"/>
                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="20,0,0,20" TextWrapping="Wrap">Pins or unpins the currently active window so it stays on top of all other windows.</TextBlock>

                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#111827">Typing Speed</TextBlock>
                        <TextBlock x:Name="TxtSpeedLabel" FontSize="13" Foreground="#374151" Margin="0,0,0,5">Base delay: 30 ms</TextBlock>
                        <Slider x:Name="SldSpeed" Minimum="0" Maximum="200" Value="30" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,20" ValueChanged="SldSpeed_ValueChanged"/>

                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#111827">Startup</TextBlock>
                        <CheckBox x:Name="ChkStartMinimized" Content="Start minimized to system tray" Margin="0,0,0,8" Foreground="#111827" Checked="ChkStartMinimized_Checked" Unchecked="ChkStartMinimized_Checked"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Auto-start with Windows (copies to AppData)" Margin="0,0,0,15" Foreground="#111827" Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Checked"/>

                        <Button Content="Reset to Defaults" HorizontalAlignment="Right" Padding="15,6" Margin="0,10,0,0"
                                Click="BtnReset_Click" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TAB 4: BETA                                                     -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TabItem Header="Beta">
                <ScrollViewer Padding="15" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Experimental Features" FontSize="13" FontWeight="SemiBold" Foreground="#92400E"/>
                                    <TextBlock FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,2,0,0">These features are under development and may not work reliably. They are disabled by default. Enable at your own risk.</TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkEnableSCBeta" Content="Smart Copy (web content &amp; image capture)" Margin="0,0,0,2" FontWeight="SemiBold" Foreground="#92400E" Checked="Beta_Changed" Unchecked="Beta_Changed"/>
                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="20,0,0,8" TextWrapping="Wrap">Copies web content including formatted text, math equations, and images. Attempts to download remote images and embed them as Base64 data so formatting is preserved when pasting elsewhere.</TextBlock>

                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="20,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center">Image conversion to pasteable format is currently unreliable across all target applications. The shortcut is registered but the feature may not produce expected results.</TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" Foreground="#92400E">Smart Copy Shortcut</TextBlock>
                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap">Configure the shortcut for Smart Copy in the Shortcuts tab (labeled as Smart Copy Beta).</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- TAB 5: ABOUT                                                    -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TabItem Header="About">
                <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="400">
                        <Image Source="assets/icon-192.png" Width="96" Height="96" Margin="0,0,0,15"/>
                        <TextBlock Text="SmartPaste" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2" Foreground="#111827"/>
                        <TextBlock Text="Version 1.0.0" FontSize="14" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" Foreground="#1F2937">
                            A lightweight Windows utility that transforms how you paste, copy, and manage text.
                            Features smart list pasting with human simulation, case conversion, always-on-top pinning, and intelligent web content copying with Base64 image embedding.
                        </TextBlock>

                        <Border BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15" Background="#F3F4F6">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#111827">Features</TextBlock>
                                <BulletDecorator><BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#1E40AF" Margin="0,0,6,0"/></BulletDecorator.Bullet><TextBlock TextWrapping="Wrap" Foreground="#1F2937">Smart Paste — 3 modes with auto-splitting</TextBlock></BulletDecorator>
                                <BulletDecorator Margin="0,4,0,0"><BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#1E40AF" Margin="0,0,6,0"/></BulletDecorator.Bullet><TextBlock TextWrapping="Wrap" Foreground="#1F2937">Telework Mode — 10 realistic typing options</TextBlock></BulletDecorator>
                                <BulletDecorator Margin="0,4,0,0"><BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#1E40AF" Margin="0,0,6,0"/></BulletDecorator.Bullet><TextBlock TextWrapping="Wrap" Foreground="#1F2937">Case Converter — Cycle text cases</TextBlock></BulletDecorator>
                                <BulletDecorator Margin="0,4,0,0"><BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#1E40AF" Margin="0,0,6,0"/></BulletDecorator.Bullet><TextBlock TextWrapping="Wrap" Foreground="#1F2937">Always On Top — Pin any window</TextBlock></BulletDecorator>
                                <BulletDecorator Margin="0,4,0,0"><BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#D97706" Margin="0,0,6,0"/></BulletDecorator.Bullet><TextBlock TextWrapping="Wrap" Foreground="#92400E">Smart Copy (Beta) — Web math/images as Base64</TextBlock></BulletDecorator>
                                <BulletDecorator Margin="0,4,0,0"><BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#1E40AF" Margin="0,0,6,0"/></BulletDecorator.Bullet><TextBlock TextWrapping="Wrap" Foreground="#1F2937">Custom Shortcuts — Visual editor</TextBlock></BulletDecorator>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15" Background="#F0F9FF">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" FontSize="16" Foreground="#1E40AF" HorizontalAlignment="Center" Margin="0,0,0,2">Hope 'n Mind</TextBlock>
                                <TextBlock FontSize="12" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Hyperlink NavigateUri="https://www.hopenmind.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#1E40AF">
                                        www.hopenmind.com
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#6B7280" TextAlignment="Center" TextWrapping="Wrap">Developed with passion for productivity and simplicity.</TextBlock>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="6" Padding="12" Background="#FEF2F2">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="#991B1B" Margin="0,0,0,5">License</TextBlock>
                                <TextBlock FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap">
                                    All Rights Reserved. This software is provided free of charge for personal, non-commercial use only.
                                    No right of exploitation, distribution, modification, or commercial use is granted without a prior written license agreement.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════ Shortcut Editor Backdrop ═══════ -->
        <Border x:Name="ShortcutBackdrop" Grid.RowSpan="2" Background="#40000000" Visibility="Collapsed" MouseDown="ShortcutBackdrop_MouseDown"/>

        <!-- ═══════ Shortcut Editor Popup (Virtual Keyboard) ═══════ -->
        <Popup x:Name="ShortcutPopup" Placement="Center" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="10" Padding="20" Width="420">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Title -->
                    <TextBlock x:Name="PopupTitle" Text="Configure Shortcut" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock x:Name="PopupDescription" Text="" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,16"/>

                    <!-- Step 1: Modifiers -->
                    <TextBlock Text="Step 1 — Select modifier keys (required)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ToggleButton x:Name="ModCtrl" Content="Ctrl" Style="{StaticResource ModToggle}" Click="Modifier_Click"/>
                        <ToggleButton x:Name="ModShift" Content="Shift" Style="{StaticResource ModToggle}" Click="Modifier_Click"/>
                        <ToggleButton x:Name="ModAlt" Content="Alt" Style="{StaticResource ModToggle}" Click="Modifier_Click"/>
                        <ToggleButton x:Name="ModWin" Content="Win" Style="{StaticResource ModToggle}" Click="Modifier_Click" Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Step 2: Key -->
                    <TextBlock Text="Step 2 — Select a key (required)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                    <StackPanel x:Name="KeyRowsPanel" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                    <!-- Preview -->
                    <Border Background="#F3F4F6" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Preview: " FontSize="12" Foreground="#6B7280"/>
                            <TextBlock x:Name="PopupPreview" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"/>
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border x:Name="PopupErrorBox" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PopupError" FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Warning -->
                    <Border x:Name="PopupWarningBox" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PopupWarning" FontSize="11" Foreground="#92400E" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Cancel" Width="72" Height="30" Margin="0,0,8,0" Click="PopupCancel_Click" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827"/>
                        <Button x:Name="PopupApplyBtn" Content="Apply" Width="72" Height="30" Click="PopupApply_Click" Background="#1E40AF" BorderBrush="#1E40AF" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
