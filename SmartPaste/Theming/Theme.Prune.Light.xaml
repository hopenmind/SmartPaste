<!-- Generated palette: Prune / Light. Every token of the mockup is exposed as a Color and a Brush. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Theme.Brand">Prune</sys:String>
    <sys:String x:Key="Theme.Mode">Light</sys:String>

    <!-- Colors -->
    <Color x:Key="Color.Bg">#F5EFDD</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface2">#EEEBE1</Color>
    <Color x:Key="Color.Ink">#2B1230</Color>
    <Color x:Key="Color.Muted">#6C5A66</Color>
    <Color x:Key="Color.Faint">#9A8C93</Color>
    <Color x:Key="Color.Accent">#7EA30C</Color>
    <Color x:Key="Color.AccentInk">#566E0C</Color>
    <Color x:Key="Color.AccentSoft">#EBF1CE</Color>
    <Color x:Key="Color.BtnFg">#1A0C1C</Color>
    <Color x:Key="Color.Panel">#2B1230</Color>
    <Color x:Key="Color.PanelInk">#EEF6D6</Color>
    <Color x:Key="Color.WmColor">#C9F04A</Color>
    <Color x:Key="Color.WheelBg">#180A1A</Color>
    <Color x:Key="Color.WheelSeg">#331739</Color>
    <Color x:Key="Color.WheelInk">#EEF6D6</Color>
    <Color x:Key="Color.Shadow">#140A18</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F5EFDD"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="#EEEBE1"/>
    <SolidColorBrush x:Key="Brush.Ink" Color="#2B1230"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#6C5A66"/>
    <SolidColorBrush x:Key="Brush.Faint" Color="#9A8C93"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#7EA30C"/>
    <SolidColorBrush x:Key="Brush.AccentInk" Color="#566E0C"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#EBF1CE"/>
    <SolidColorBrush x:Key="Brush.BtnFg" Color="#1A0C1C"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#2B1230"/>
    <SolidColorBrush x:Key="Brush.PanelInk" Color="#EEF6D6"/>
    <SolidColorBrush x:Key="Brush.WmColor" Color="#C9F04A"/>
    <SolidColorBrush x:Key="Brush.WheelBg" Color="#180A1A"/>
    <SolidColorBrush x:Key="Brush.WheelSeg" Color="#331739"/>
    <SolidColorBrush x:Key="Brush.WheelInk" Color="#EEF6D6"/>

    <!-- Derived translucent brushes (CSS color-mix equivalents) -->
    <SolidColorBrush x:Key="Brush.InkA08" Color="#142B1230"/>
    <SolidColorBrush x:Key="Brush.InkA14" Color="#242B1230"/>
    <SolidColorBrush x:Key="Brush.InkA18" Color="#2E2B1230"/>
    <SolidColorBrush x:Key="Brush.AccentA42" Color="#6B7EA30C"/>
    <SolidColorBrush x:Key="Brush.AccentA62" Color="#9E7EA30C"/>
    <SolidColorBrush x:Key="Brush.AccentA85" Color="#D97EA30C"/>
    <SolidColorBrush x:Key="Brush.PanelA55" Color="#8C2B1230"/>
    <SolidColorBrush x:Key="Brush.WhiteA08" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.WhiteA16" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ShadowA28" Color="#47140A18"/>

    <!-- Brand emblem for this palette -->
    <BitmapImage x:Key="Image.Emblem" UriSource="pack://application:,,,/assets/mark-prune.png"/>

</ResourceDictionary>
