<!-- Generated palette: Aubergine / Dark. Every token of the mockup is exposed as a Color and a Brush. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Theme.Brand">Aubergine</sys:String>
    <sys:String x:Key="Theme.Mode">Dark</sys:String>

    <!-- Colors -->
    <Color x:Key="Color.Bg">#140A16</Color>
    <Color x:Key="Color.Surface">#20112A</Color>
    <Color x:Key="Color.Surface2">#180D1E</Color>
    <Color x:Key="Color.Ink">#F2E8EC</Color>
    <Color x:Key="Color.Muted">#B79FB0</Color>
    <Color x:Key="Color.Faint">#7E6577</Color>
    <Color x:Key="Color.Accent">#E9B657</Color>
    <Color x:Key="Color.AccentInk">#F0C574</Color>
    <Color x:Key="Color.AccentSoft">#33241A</Color>
    <Color x:Key="Color.BtnFg">#20101F</Color>
    <Color x:Key="Color.Panel">#0E070F</Color>
    <Color x:Key="Color.PanelInk">#F0C574</Color>
    <Color x:Key="Color.WmColor">#F0C574</Color>
    <Color x:Key="Color.WheelBg">#0C060E</Color>
    <Color x:Key="Color.WheelSeg">#241130</Color>
    <Color x:Key="Color.WheelInk">#F3E9DA</Color>
    <Color x:Key="Color.Shadow">#140A18</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#140A16"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#20112A"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="#180D1E"/>
    <SolidColorBrush x:Key="Brush.Ink" Color="#F2E8EC"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#B79FB0"/>
    <SolidColorBrush x:Key="Brush.Faint" Color="#7E6577"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#E9B657"/>
    <SolidColorBrush x:Key="Brush.AccentInk" Color="#F0C574"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#33241A"/>
    <SolidColorBrush x:Key="Brush.BtnFg" Color="#20101F"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#0E070F"/>
    <SolidColorBrush x:Key="Brush.PanelInk" Color="#F0C574"/>
    <SolidColorBrush x:Key="Brush.WmColor" Color="#F0C574"/>
    <SolidColorBrush x:Key="Brush.WheelBg" Color="#0C060E"/>
    <SolidColorBrush x:Key="Brush.WheelSeg" Color="#241130"/>
    <SolidColorBrush x:Key="Brush.WheelInk" Color="#F3E9DA"/>

    <!-- Derived translucent brushes (CSS color-mix equivalents) -->
    <SolidColorBrush x:Key="Brush.InkA08" Color="#14F2E8EC"/>
    <SolidColorBrush x:Key="Brush.InkA14" Color="#24F2E8EC"/>
    <SolidColorBrush x:Key="Brush.InkA18" Color="#2EF2E8EC"/>
    <SolidColorBrush x:Key="Brush.AccentA42" Color="#6BE9B657"/>
    <SolidColorBrush x:Key="Brush.AccentA62" Color="#9EE9B657"/>
    <SolidColorBrush x:Key="Brush.AccentA85" Color="#D9E9B657"/>
    <SolidColorBrush x:Key="Brush.PanelA55" Color="#8C0E070F"/>
    <SolidColorBrush x:Key="Brush.WhiteA08" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.WhiteA16" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ShadowA28" Color="#47140A18"/>

    <!-- Brand emblem for this palette -->
    <BitmapImage x:Key="Image.Emblem" UriSource="pack://application:,,,/assets/mark-aubergine.png"/>

</ResourceDictionary>
