<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Pill toggle switch -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="12" Background="{DynamicResource Brush.InkA18}">
                        <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White"
                                 HorizontalAlignment="Left" Margin="2.5,0,0,0">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,2.5,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat (secondary) button -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary (accent) button -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.BtnFg}"/>
    </Style>

    <!-- Chip (selectable) -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{DynamicResource Brush.Surface2}" CornerRadius="999" Padding="11,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.BtnFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keycap (clickable shortcut chip) -->
    <Style x:Key="KeyCap" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource Brush.Bg}" CornerRadius="7" Padding="9,5"
                            BorderThickness="1" BorderBrush="{DynamicResource Brush.InkA14}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon button (corner controls). Content = a MDL2 glyph or Path. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentInk}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.20" Color="#140A18"/></Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MDL2 icon text -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentInk}"/>
    </Style>

    <!-- Section label (mono, uppercase) -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}"/>
    </Style>

    <!-- Card surface -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="4,14"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.12" Color="#140A18"/></Setter.Value>
        </Setter>
    </Style>

    <!-- Themed ToolTip (default WPF one renders a bare white box) -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Accent}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="#140A18"/></Border.Effect>
                        <ContentPresenter TextElement.Foreground="{DynamicResource Brush.Ink}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed tray context menu (default one paints item background over the text) -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Accent}"
                            BorderThickness="1" CornerRadius="10" Padding="4">
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4" Color="#140A18"/></Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base tray menu item = plain action row (Open / Exit) -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,8" Margin="2,1">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" MinWidth="200"
                                          TextElement.Foreground="{DynamicResource Brush.Ink}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tray toggle row: label + pill switch (visual only, driven by MenuItem.IsChecked) -->
    <Style x:Key="TrayMenuToggle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,7" Margin="2,1">
                        <Grid MinWidth="210">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource Brush.Ink}"/>
                            <Border x:Name="track" Grid.Column="1" Width="38" Height="21" CornerRadius="11"
                                    Background="{DynamicResource Brush.InkA18}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tray brand row: label + colour swatch (colour via Tag) + check when active -->
    <Style x:Key="TrayMenuBrand" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,7" Margin="2,1">
                        <Grid MinWidth="210">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource Brush.Ink}"/>
                            <Border Grid.Column="1" Width="16" Height="16" CornerRadius="4" Margin="16,0,0,0"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                    BorderBrush="{DynamicResource Brush.InkA18}" BorderThickness="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="tick" Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="13"
                                       Foreground="{DynamicResource Brush.AccentInk}" Visibility="Hidden"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tray submenu header: label + chevron; opens a themed popup of children -->
    <Style x:Key="TrayMenuSub" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,8" Margin="2,1">
                        <Grid MinWidth="210">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource Brush.Ink}"/>
                            <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="-4"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Accent}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" Margin="6">
                                    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4" Color="#140A18"/></Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tray shortcut row: feature name + current gesture (opens the rebind editor) -->
    <Style x:Key="TrayMenuShortcut" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,7" Margin="2,1">
                        <Grid MinWidth="230">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource Brush.Ink}"/>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface2}" CornerRadius="5" Padding="8,2"
                                    Margin="18,0,0,0" BorderBrush="{DynamicResource Brush.InkA14}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding InputGestureText}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource Brush.AccentInk}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed Separator inside the tray menu -->
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Brush.InkA14}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
