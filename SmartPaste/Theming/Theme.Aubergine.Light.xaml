<!-- Generated palette: Aubergine / Light. Every token of the mockup is exposed as a Color and a Brush. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Theme.Brand">Aubergine</sys:String>
    <sys:String x:Key="Theme.Mode">Light</sys:String>

    <!-- Colors -->
    <Color x:Key="Color.Bg">#F5EEDD</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface2">#EFE8E4</Color>
    <Color x:Key="Color.Ink">#26102A</Color>
    <Color x:Key="Color.Muted">#6E5A6A</Color>
    <Color x:Key="Color.Faint">#9B8C97</Color>
    <Color x:Key="Color.Accent">#C6862B</Color>
    <Color x:Key="Color.AccentInk">#8A4B0A</Color>
    <Color x:Key="Color.AccentSoft">#F4E7CE</Color>
    <Color x:Key="Color.BtnFg">#20101F</Color>
    <Color x:Key="Color.Panel">#241026</Color>
    <Color x:Key="Color.PanelInk">#F3E9DA</Color>
    <Color x:Key="Color.WmColor">#E9B657</Color>
    <Color x:Key="Color.WheelBg">#17091A</Color>
    <Color x:Key="Color.WheelSeg">#2E1633</Color>
    <Color x:Key="Color.WheelInk">#F3E9DA</Color>
    <Color x:Key="Color.Shadow">#140A18</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F5EEDD"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="#EFE8E4"/>
    <SolidColorBrush x:Key="Brush.Ink" Color="#26102A"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#6E5A6A"/>
    <SolidColorBrush x:Key="Brush.Faint" Color="#9B8C97"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#C6862B"/>
    <SolidColorBrush x:Key="Brush.AccentInk" Color="#8A4B0A"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#F4E7CE"/>
    <SolidColorBrush x:Key="Brush.BtnFg" Color="#20101F"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#241026"/>
    <SolidColorBrush x:Key="Brush.PanelInk" Color="#F3E9DA"/>
    <SolidColorBrush x:Key="Brush.WmColor" Color="#E9B657"/>
    <SolidColorBrush x:Key="Brush.WheelBg" Color="#17091A"/>
    <SolidColorBrush x:Key="Brush.WheelSeg" Color="#2E1633"/>
    <SolidColorBrush x:Key="Brush.WheelInk" Color="#F3E9DA"/>

    <!-- Derived translucent brushes (CSS color-mix equivalents) -->
    <SolidColorBrush x:Key="Brush.InkA08" Color="#1426102A"/>
    <SolidColorBrush x:Key="Brush.InkA14" Color="#2426102A"/>
    <SolidColorBrush x:Key="Brush.InkA18" Color="#2E26102A"/>
    <SolidColorBrush x:Key="Brush.AccentA42" Color="#6BC6862B"/>
    <SolidColorBrush x:Key="Brush.AccentA62" Color="#9EC6862B"/>
    <SolidColorBrush x:Key="Brush.AccentA85" Color="#D9C6862B"/>
    <SolidColorBrush x:Key="Brush.PanelA55" Color="#8C241026"/>
    <SolidColorBrush x:Key="Brush.WhiteA08" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.WhiteA16" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ShadowA28" Color="#47140A18"/>

    <!-- Brand emblem for this palette -->
    <BitmapImage x:Key="Image.Emblem" UriSource="pack://application:,,,/assets/mark-aubergine.png"/>

</ResourceDictionary>
