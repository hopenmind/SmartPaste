<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>

    <AssemblyName>SmartPaste</AssemblyName>
    <RootNamespace>SmartPaste</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Hope 'n Mind</Company>
    <Product>SmartPaste</Product>
    <Copyright>Copyright © 2026 Hope 'n Mind</Copyright>
    <Description>A lightweight Windows utility that transforms how you paste, copy, and manage text.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\icon-192.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="InputSimulatorCore" Version="1.0.5" />
  </ItemGroup>

</Project>
